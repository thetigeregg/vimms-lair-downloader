# Direktori output download
# Struktur: DOWNLOAD_DIR/<SYSTEM>/<game_title>/
# Contoh hasil: ~/roms/Nintendo/Super Mario Bros./Super Mario Bros. (World).nes
DOWNLOAD_DIR=~/roms

# Jumlah koneksi paralel aria2c per file (default: 1)
ARIA2_CONNECTIONS=1

# Timeout koneksi HTTP dalam detik (default: 30)
HTTP_TIMEOUT=30

# Gunakan wget sebagai pengganti aria2c (set ke 1 untuk aktifkan)
# USE_WGET=1
