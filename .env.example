# Download output directory
# Structure: DOWNLOAD_DIR/<SYSTEM>/<game_title>/
# Example result: ~/roms/Nintendo/Super Mario Bros./Super Mario Bros. (World).nes
DOWNLOAD_DIR=~/roms

# Number of parallel aria2c connections per file (default: 1)
ARIA2_CONNECTIONS=1

# HTTP connection timeout in seconds (default: 30)
HTTP_TIMEOUT=30

# Use wget instead of aria2c (set to 1 to enable)
# USE_WGET=1
